# Copy to .env.local for local development. Real values live in Vercel project
# settings (scoped per environment: Development / Preview / Production) and are
# never committed.

# Canonical production URL (no trailing slash) — used for the sitemap, robots.txt,
# and Open Graph metadataBase. Falls back to Vercel's own preview URL, then
# localhost, if unset — only needs a real value once rymx-prod has a domain.
NEXT_PUBLIC_SITE_URL=

# --- Client-side Firebase config (safe to expose; NEXT_PUBLIC_ only) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only for local dev / CI to point both client and admin SDKs at
# the Firebase Emulator Suite. Never set this on Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Server-only secrets (never NEXT_PUBLIC_, never committed) ---
# Base64-encoded Firebase service-account JSON (avoids multiline env var issues
# in Vercel). Generate: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Bearer secret required on /api/cron/* routes (Vercel Cron -> our endpoints).
CRON_SECRET=

# Transactional email provider (order confirmations, promo codes, etc.)
RESEND_API_KEY=

# --- Error monitoring (Sentry) ---
# All four are optional — every Sentry.init() call in this codebase is a
# documented no-op without a dsn, so the app runs fine with these unset.
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN come from the Sentry project settings
# page (same value, but the client one needs the NEXT_PUBLIC_ prefix to reach
# the browser bundle). SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only
# needed for source-map upload during `next build` (better stack traces in
# Sentry) — an auth token with "project:releases" scope from
# sentry.io/settings/account/api/auth-tokens/.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
