# Copy to .env.local for local development. Real values live in Vercel project
# settings (scoped per environment: Development / Preview / Production) and are
# never committed.

# Canonical production URL (no trailing slash) — used for the sitemap, robots.txt,
# and Open Graph metadataBase. Falls back to Vercel's own preview URL, then
# localhost, if unset — only needs a real value once rymx-prod has a domain.
NEXT_PUBLIC_SITE_URL=

# --- Client-side Firebase config (safe to expose; NEXT_PUBLIC_ only) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only for local dev / CI to point both client and admin SDKs at
# the Firebase Emulator Suite. Never set this on Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Server-only secrets (never NEXT_PUBLIC_, never committed) ---
# Base64-encoded Firebase service-account JSON (avoids multiline env var issues
# in Vercel). Generate: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Bearer secret required on /api/cron/* routes (Vercel Cron -> our endpoints).
CRON_SECRET=

# Transactional email (order confirmations, status updates, promo codes,
# staff invites) sent via Gmail SMTP through a Gmail App Password — not the
# account's real password. Setup:
#   1. On the sending Gmail account, turn on 2-Step Verification:
#      myaccount.google.com/security
#   2. Generate an App Password: myaccount.google.com/apppasswords
#      (app: "Mail", device: "Other" — name it e.g. "RYMX"). Google shows a
#      16-character password once — copy it, spaces don't matter.
#   3. GMAIL_USER = the full Gmail address. GMAIL_APP_PASSWORD = that
#      16-character password (not your login password).
# Both unset = emails are skipped and logged to console instead of sent —
# safe default for local dev.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Media hosting (Cloudinary) ---
# Product/collection image uploads. Signed server-side, so credentials are
# server-only (never NEXT_PUBLIC_). Easiest: paste the single CLOUDINARY_URL
# from the Cloudinary dashboard (the SDK reads it automatically). The three
# discrete vars below are an equivalent alternative — set one form or the other.
CLOUDINARY_URL=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Error monitoring (Sentry) ---
# All four are optional — every Sentry.init() call in this codebase is a
# documented no-op without a dsn, so the app runs fine with these unset.
# SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN come from the Sentry project settings
# page (same value, but the client one needs the NEXT_PUBLIC_ prefix to reach
# the browser bundle). SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only
# needed for source-map upload during `next build` (better stack traces in
# Sentry) — an auth token with "project:releases" scope from
# sentry.io/settings/account/api/auth-tokens/.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Media-buying / tracking pixels (optional) ---
# Both are no-ops until set (src/components/analytics/PixelScripts.tsx).
# CSP (src/proxy.ts) already allowlists both platforms' domains.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
