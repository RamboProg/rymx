rules_version = '2';

// Deny-by-default baseline for Phase 0. Each feature module owns and documents
// the rules it needs (see src/modules/<feature>/rules.md); those blocks are
// composed into this file as each module is built.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
